# Reference media / screenshots (large, not source)
.ref/

# Editor / OS cruft
*.swp
.DS_Store
*.log
# Repository-local agent guidance must never ship in a plugin snapshot.
AGENTS.md
__pycache__/
*.py[cod]

# Local runtime state
*.lock

