#!/usr/bin/env python3
"""State and no-key market data backend for SuperNotch Markets."""

import fcntl
import json
import math
import os
import re
import sys
import time
import uuid
from contextlib import contextmanager
from datetime import date
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import quote
from urllib.request import Request, urlopen

STATE_DIR = Path.home() / ".local" / "state" / "omarchy-supernotch"
STATE_FILE = STATE_DIR / "markets.json"
CACHE_DIR = STATE_DIR / "markets-cache"
LOCK_FILE = STATE_DIR / "markets.lock"
SYMBOL_RE = re.compile(r"^[A-Z0-9][A-Z0-9.^=-]{0,19}$")
CACHE_TTL = 300
MAX_SEARCH_DOWNLOAD = 1024 * 1024
MAX_FINANCIAL_VALUE = 1_000_000_000_000_000
RANGES = {"1D": ("1d", "5m"), "1W": ("5d", "15m"), "1M": ("1mo", "1d"),
          "3M": ("3mo", "1d"), "1Y": ("1y", "1d"), "5Y": ("5y", "1wk")}
MUTATING_COMMANDS = {"add-symbol", "toggle-favorite", "reorder", "add-lot", "edit-lot", "remove-lot", "remove-symbol"}


def empty_state():
    return {"watchlist": [], "favorites": [], "holdings": {}}


def validate_state(data):
    if not isinstance(data, dict) or not isinstance(data.get("watchlist"), list) or not isinstance(data.get("holdings"), dict):
        raise ValueError("invalid market state; refusing to overwrite it")
    watchlist = data["watchlist"]
    if (any(not isinstance(ticker, str) or not SYMBOL_RE.fullmatch(ticker) for ticker in watchlist)
            or len(set(watchlist)) != len(watchlist)):
        raise ValueError("invalid market state; refusing to overwrite it")
    if "favorites" not in data:
        data["favorites"] = []
    favorites = data["favorites"]
    if (not isinstance(favorites, list)
            or any(not isinstance(ticker, str) or ticker not in watchlist for ticker in favorites)
            or len(set(favorites)) != len(favorites)):
        raise ValueError("invalid market state; refusing to overwrite it")
    for ticker, lots in data["holdings"].items():
        if not isinstance(ticker, str) or ticker not in watchlist or not isinstance(lots, list):
            raise ValueError("invalid market state; refusing to overwrite it")
        lot_ids = set()
        for lot in lots:
            if not isinstance(lot, dict) or not isinstance(lot.get("id"), str) or not lot["id"] or lot["id"] in lot_ids:
                raise ValueError("invalid market state; refusing to overwrite it")
            try:
                raw_quantity = lot["quantity"]
                raw_price = lot.get("price")
                if (isinstance(raw_quantity, bool) or not isinstance(raw_quantity, (int, float))
                        or (raw_price is not None and (isinstance(raw_price, bool) or not isinstance(raw_price, (int, float))))):
                    raise ValueError("holding values must be JSON numbers")
                quantity = float(raw_quantity)
                price = None if raw_price is None else float(raw_price)
                purchase_date = lot.get("date")
                if purchase_date is not None:
                    date.fromisoformat(purchase_date)
            except (KeyError, TypeError, ValueError) as error:
                raise ValueError("invalid market state; refusing to overwrite it") from error
            if (not math.isfinite(quantity) or quantity <= 0 or quantity > MAX_FINANCIAL_VALUE
                    or (price is not None and (not math.isfinite(price) or price <= 0 or price > MAX_FINANCIAL_VALUE))):
                raise ValueError("invalid market state; refusing to overwrite it")
            lot_ids.add(lot["id"])
    return data


def load_state():
    try:
        data = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return empty_state()
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError("invalid market state; refusing to overwrite it") from error
    return validate_state(data)


def save_state(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(f".tmp.{os.getpid()}")
    tmp.write_text(json.dumps(state, separators=(",", ":"), allow_nan=False) + "\n", encoding="utf-8")
    os.replace(tmp, STATE_FILE)


@contextmanager
def state_lock():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def symbol(value):
    value = value.strip().upper()
    if not SYMBOL_RE.fullmatch(value):
        raise ValueError("invalid symbol")
    return value


def positive_number(value, label):
    try:
        normalized = value.replace(",", ".") if isinstance(value, str) and "," in value and "." not in value else value
        number = float(normalized)
    except (TypeError, ValueError):
        raise ValueError(f"invalid {label}") from None
    if number <= 0 or not math.isfinite(number) or number > MAX_FINANCIAL_VALUE:
        raise ValueError(f"invalid {label}")
    return number


def optional_date(value):
    if not value:
        return None
    try:
        return date.fromisoformat(value).isoformat()
    except ValueError:
        raise ValueError("invalid purchase date") from None


def optional_price(value):
    return positive_number(value, "purchase price") if value else None


def lots_for(state, ticker):
    return state["holdings"].setdefault(ticker, [])


def portfolio_summary(lots, current_price):
    quantity = sum(float(lot["quantity"]) for lot in lots)
    market_value = round(quantity * current_price, 4)
    complete = bool(lots) and all(lot.get("price") is not None for lot in lots)
    cost_basis = round(sum(float(lot["quantity"]) * float(lot["price"]) for lot in lots), 4) if complete else None
    gain = round(market_value - cost_basis, 4) if cost_basis is not None else None
    gain_pct = round(gain / cost_basis * 100, 4) if cost_basis else None
    return {"quantity": round(quantity, 8), "marketValue": market_value,
            "costBasis": cost_basis, "gain": gain, "gainPct": gain_pct}


def portfolio_by_currency(assets, portfolio_complete=True):
    groups = {}
    for asset in assets:
        currency = asset.get("currency")
        if not currency or asset.get("error") or not asset.get("quantity"):
            continue
        group = groups.setdefault(currency, {"value": 0.0, "costBasis": 0.0, "complete": True})
        group["value"] += float(asset.get("marketValue") or 0)
        if asset.get("costBasis") is None:
            group["complete"] = False
        else:
            group["costBasis"] += float(asset["costBasis"])
    result = []
    for currency in sorted(groups):
        group = groups[currency]
        complete = group["complete"] and portfolio_complete
        cost = round(group["costBasis"], 4) if complete else None
        value = round(group["value"], 4)
        result.append({"currency": currency, "value": value, "costBasis": cost,
                       "gain": round(value - cost, 4) if cost is not None else None,
                       "complete": complete})
    return result


def unavailable_asset(state, ticker, message):
    return {"symbol": ticker, "value": None, "price": None, "currency": "",
            "source": "Yahoo Finance", "asOf": None, "fetchedAt": 0,
            "marketState": "UNKNOWN", "error": str(message), "stale": True,
            **portfolio_summary(state["holdings"].get(ticker, []), 0)}


def chart_result(payload):
    try:
        result = payload["chart"]["result"][0]
        if payload["chart"].get("error") or not result:
            raise ValueError("provider returned no chart")
        return result
    except (KeyError, IndexError, TypeError):
        raise ValueError("invalid Yahoo chart response") from None


def parse_chart(payload):
    result = chart_result(payload)
    timestamps = result.get("timestamp") or []
    closes = ((result.get("indicators") or {}).get("quote") or [{}])[0].get("close") or []
    points = [{"time": int(stamp), "value": round(float(value), 6)}
              for stamp, value in zip(timestamps, closes) if value is not None]
    if not points:
        raise ValueError("provider returned no prices")
    return {"points": points}


def parse_quote(payload):
    result = chart_result(payload)
    meta = result.get("meta") or {}
    points = parse_chart(payload)["points"]
    price = meta.get("regularMarketPrice", points[-1]["value"])
    previous = meta.get("chartPreviousClose") or meta.get("previousClose")
    if previous is None:
        previous = points[0]["value"]
    price, previous = float(price), float(previous)
    change = price - previous
    market_time = int(meta.get("regularMarketTime") or points[-1]["time"])
    market_state = str(meta.get("marketState") or "UNKNOWN").upper()
    return {"symbol": str(meta.get("symbol") or ""), "currency": str(meta.get("currency") or ""),
            "value": round(price, 6), "price": round(price, 6),
            "previousClose": round(previous, 6), "dayChange": round(change, 6),
            "dayChangePct": round(change / previous * 100, 4) if previous else None,
            "source": "Yahoo Finance", "asOf": market_time,
            "marketTime": market_time, "marketState": market_state}


def parse_search(payload):
    results = []
    seen = set()
    allowed_types = {"EQUITY", "ETF", "MUTUALFUND", "INDEX", "CRYPTOCURRENCY", "CURRENCY", "FUTURE"}
    for item in payload.get("quotes") or []:
        try:
            ticker = symbol(str(item.get("symbol") or ""))
        except ValueError:
            continue
        quote_type = str(item.get("quoteType") or "").upper()
        if ticker in seen or quote_type not in allowed_types:
            continue
        seen.add(ticker)
        results.append({
            "symbol": ticker,
            "name": str(item.get("longname") or item.get("shortname") or ticker).strip(),
            "exchange": str(item.get("exchDisp") or item.get("exchange") or "").strip(),
            "type": str(item.get("typeDisp") or quote_type.title()).strip(),
        })
        if len(results) >= 8:
            break
    return results


def fixture_path(ticker, provider_range):
    directory = os.environ.get("MARKETS_FIXTURE_DIR")
    return Path(directory) / f"markets-{ticker}-{provider_range}.json" if directory else None


def cache_path(ticker, provider_range):
    safe = ticker.replace("^", "_").replace("=", "_")
    return CACHE_DIR / f"{safe}-{provider_range}.json"


def read_json(path):
    return json.loads(path.read_text(encoding="utf-8"))


def write_cache(path, payload):
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(f".tmp.{os.getpid()}")
    tmp.write_text(json.dumps({"fetchedAt": int(time.time()), "payload": payload}, separators=(",", ":")), encoding="utf-8")
    os.replace(tmp, path)


def fetch_yahoo(ticker, provider_range, interval):
    fixture = fixture_path(ticker, provider_range)
    if fixture and fixture.is_file():
        return read_json(fixture)
    if os.environ.get("MARKETS_OFFLINE") == "1":
        raise OSError("offline fixture mode")
    last_error = None
    for host in ("query1.finance.yahoo.com", "query2.finance.yahoo.com"):
        url = (f"https://{host}/v8/finance/chart/" + quote(ticker, safe="") +
               f"?range={provider_range}&interval={interval}&includePrePost=false&events=div%2Csplits")
        request = Request(url, headers={"User-Agent": "Mozilla/5.0 SuperNotch/1.0", "Accept": "application/json"})
        try:
            with urlopen(request, timeout=12) as response:
                payload = json.loads(response.read().decode("utf-8"))
            parse_chart(payload)
            return payload
        except (HTTPError, URLError, TimeoutError, json.JSONDecodeError, ValueError) as exc:
            last_error = exc
    raise OSError(f"market provider unavailable: {last_error}") from last_error


def fetch_search(value):
    query = value.strip()
    if not query or len(query) > 80 or any(ord(char) < 32 for char in query):
        raise ValueError("invalid search query")
    fixture = os.environ.get("MARKETS_SEARCH_FIXTURE")
    if fixture:
        return parse_search(read_json(Path(fixture)))
    if os.environ.get("MARKETS_OFFLINE") == "1":
        raise OSError("offline fixture mode")
    last_error = None
    for host in ("query1.finance.yahoo.com", "query2.finance.yahoo.com"):
        url = (f"https://{host}/v1/finance/search?q=" + quote(query, safe="") +
               "&quotesCount=8&newsCount=0&enableFuzzyQuery=true")
        request = Request(url, headers={"User-Agent": "Mozilla/5.0 SuperNotch/1.0", "Accept": "application/json"})
        try:
            with urlopen(request, timeout=12) as response:
                raw = response.read(MAX_SEARCH_DOWNLOAD + 1)
            if len(raw) > MAX_SEARCH_DOWNLOAD:
                raise ValueError("search response exceeds 1 MiB")
            return parse_search(json.loads(raw.decode("utf-8")))
        except (HTTPError, URLError, TimeoutError, UnicodeDecodeError, json.JSONDecodeError, ValueError) as exc:
            last_error = exc
    raise OSError(f"market search unavailable: {last_error}") from last_error


def market_payload(ticker, range_name, force=False):
    if range_name not in RANGES:
        raise ValueError("invalid chart range")
    provider_range, interval = RANGES[range_name]
    path = cache_path(ticker, provider_range)
    cached = None
    try:
        cached = read_json(path)
    except (OSError, ValueError, json.JSONDecodeError):
        pass
    if cached and not force and int(time.time()) - int(cached.get("fetchedAt", 0)) < CACHE_TTL:
        return cached["payload"], False, int(cached["fetchedAt"]), ""
    try:
        payload = fetch_yahoo(ticker, provider_range, interval)
        parse_chart(payload)
        write_cache(path, payload)
        return payload, False, int(time.time()), ""
    except (OSError, ValueError) as exc:
        if cached and cached.get("payload"):
            return cached["payload"], True, int(cached.get("fetchedAt", 0)), f"Using cached data: {exc}"
        raise


def asset_snapshot(state, ticker, force=False):
    try:
        payload, stale, fetched_at, warning = market_payload(ticker, "1W", force)
        quote_data = parse_quote(payload)
        chart_data = parse_chart(payload)
        result = {**quote_data, "sparkline": [point["value"] for point in chart_data["points"]],
                  "stale": stale, "fetchedAt": fetched_at, "updatedAt": fetched_at}
        result.update(portfolio_summary(state["holdings"].get(ticker, []), quote_data["price"]))
        if warning:
            result["warning"] = warning
        return result
    except (OSError, ValueError) as exc:
        return unavailable_asset(state, ticker, exc)


def cached_asset_snapshot(state, ticker):
    path = cache_path(ticker, RANGES["1W"][0])
    try:
        cached = read_json(path)
        fetched_at = int(cached.get("fetchedAt", 0))
        payload = cached["payload"]
        quote_data = parse_quote(payload)
        chart_data = parse_chart(payload)
        result = {**quote_data, "sparkline": [point["value"] for point in chart_data["points"]],
                  "stale": int(time.time()) - fetched_at >= CACHE_TTL,
                  "fetchedAt": fetched_at, "updatedAt": fetched_at}
        result.update(portfolio_summary(state["holdings"].get(ticker, []), quote_data["price"]))
        return result
    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
        return unavailable_asset(state, ticker, exc)


def pulse_payload(state, assets):
    favorites = set(state["favorites"])
    for asset in assets:
        asset["favorite"] = asset.get("symbol") in favorites
    unavailable_positions = [asset["symbol"] for asset in assets
                             if asset.get("error") and asset.get("quantity", 0) > 0]
    portfolio_complete = not unavailable_positions
    return {"assets": assets, "watchlist": state["watchlist"], "favorites": state["favorites"],
            "holdings": state["holdings"],
            "portfolioByCurrency": portfolio_by_currency(assets, portfolio_complete),
            "portfolioComplete": portfolio_complete,
            "unavailablePositions": unavailable_positions}


def emit(value):
    print(json.dumps(value, separators=(",", ":"), allow_nan=False))


def main(argv, locked=False):
    command = argv[0] if argv else "state"
    if command in MUTATING_COMMANDS and not locked:
        with state_lock():
            return main(argv, True)
    state = load_state()
    if command == "state":
        emit(state)
    elif command == "search":
        emit(fetch_search(argv[1] if len(argv) > 1 else ""))
    elif command == "add-symbol":
        ticker = symbol(argv[1] if len(argv) > 1 else "")
        if ticker not in state["watchlist"]:
            state["watchlist"].append(ticker)
            save_state(state)
        emit(state)
    elif command == "toggle-favorite":
        ticker = symbol(argv[1])
        if ticker not in state["watchlist"]:
            state["watchlist"].append(ticker)
        if ticker in state["favorites"]:
            state["favorites"].remove(ticker)
        else:
            state["favorites"].append(ticker)
        save_state(state)
        emit(state)
    elif command == "reorder":
        ticker = symbol(argv[1])
        delta = int(argv[2])
        if ticker not in state["watchlist"]:
            raise ValueError("symbol not found")
        current = state["watchlist"].index(ticker)
        target = max(0, min(len(state["watchlist"]) - 1, current + delta))
        if target != current:
            state["watchlist"].insert(target, state["watchlist"].pop(current))
            save_state(state)
        emit(state)
    elif command == "add-lot":
        ticker = symbol(argv[1])
        lot = {"id": uuid.uuid4().hex[:12], "quantity": positive_number(argv[2], "quantity"),
               "date": optional_date(argv[3]), "price": optional_price(argv[4])}
        if ticker not in state["watchlist"]:
            state["watchlist"].append(ticker)
        lots_for(state, ticker).append(lot)
        save_state(state)
        emit(state)
    elif command == "edit-lot":
        ticker, lot_id = symbol(argv[1]), argv[2]
        lots = lots_for(state, ticker)
        lot = next((item for item in lots if item.get("id") == lot_id), None)
        if lot is None:
            raise ValueError("lot not found")
        lot.update({"quantity": positive_number(argv[3], "quantity"),
                    "date": optional_date(argv[4]), "price": optional_price(argv[5])})
        save_state(state)
        emit(state)
    elif command == "remove-lot":
        ticker, lot_id = symbol(argv[1]), argv[2]
        lots = lots_for(state, ticker)
        next_lots = [lot for lot in lots if lot.get("id") != lot_id]
        if len(next_lots) == len(lots):
            raise ValueError("lot not found")
        if next_lots:
            state["holdings"][ticker] = next_lots
        else:
            state["holdings"].pop(ticker, None)
        save_state(state)
        emit(state)
    elif command == "remove-symbol":
        ticker = symbol(argv[1])
        if state["holdings"].get(ticker) and (len(argv) < 3 or argv[2] != "confirm"):
            raise ValueError("confirmation required for symbol with holdings")
        state["watchlist"] = [item for item in state["watchlist"] if item != ticker]
        state["favorites"] = [item for item in state["favorites"] if item != ticker]
        state["holdings"].pop(ticker, None)
        save_state(state)
        emit(state)
    elif command == "summary":
        ticker = symbol(argv[1])
        emit(portfolio_summary(state["holdings"].get(ticker, []), positive_number(argv[2], "current price")))
    elif command == "parse-quote":
        emit(parse_quote(read_json(Path(argv[1]))))
    elif command == "parse-chart":
        emit(parse_chart(read_json(Path(argv[1]))))
    elif command == "refresh":
        force = "--force" in argv[1:]
        assets = [asset_snapshot(state, ticker, force) for ticker in state["watchlist"]]
        emit(pulse_payload(state, assets))
    elif command == "snapshot":
        emit(pulse_payload(state, [cached_asset_snapshot(state, ticker) for ticker in state["watchlist"]]))
    elif command == "chart":
        ticker, range_name = symbol(argv[1]), argv[2].upper()
        payload, stale, fetched_at, warning = market_payload(ticker, range_name, "--force" in argv[3:])
        result = parse_chart(payload)
        quote_data = parse_quote(payload)
        result.update({"symbol": ticker, "range": range_name,
                       "currency": quote_data["currency"], "source": quote_data["source"],
                       "asOf": quote_data["asOf"], "fetchedAt": fetched_at,
                       "marketState": quote_data["marketState"], "stale": stale,
                       "updatedAt": fetched_at})
        if warning:
            result["warning"] = warning
        emit(result)
    else:
        raise ValueError(f"unknown command: {command}")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (ValueError, IndexError, OSError) as exc:
        print(str(exc), file=sys.stderr)
        raise SystemExit(2)
