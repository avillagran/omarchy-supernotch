#!/usr/bin/env bash
# supernotch-weather launcher: pick the native binary for this machine's architecture.
# The real backend is the Rust binary built from plugins/weather/rust (no Python runtime needed).
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

case "$(uname -m)" in
  aarch64|arm64) ARCH_DIR="aarch64" ;;
  x86_64|amd64)  ARCH_DIR="x86_64" ;;
  *)
    echo "supernotch-weather: unsupported architecture: $(uname -m)" >&2
    exit 1
    ;;
esac

BIN="$SELF_DIR/bin/$ARCH_DIR/supernotch-weather"
if [ ! -x "$BIN" ]; then
  echo "supernotch-weather: missing binary for $ARCH_DIR ($BIN)" >&2
  exit 1
fi

exec "$BIN" "$@"
